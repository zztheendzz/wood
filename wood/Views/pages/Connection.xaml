<Page x:Class="wood.Views.pages.Connection"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:wood.ViewModels"
      xmlns:vm="clr-namespace:wood.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="850"
      Title="Connection">

    <Page.DataContext>
        <vm:VM/>
    </Page.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Cấu hình COM -->
            <RowDefinition Height="Auto"/>
            <!-- Cấu hình IP Camera -->
            <RowDefinition Height="*"/>
            <!-- Dữ liệu nhận & Xem Video -->
        </Grid.RowDefinitions>

        <!-- ================= KHU VỰC TRUYỀN THÔNG CỔNG COM ================= -->
        <GroupBox Header=" Cấu hình Cổng COM (Serial Port) " Grid.Row="0" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Cổng COM & Baudrate -->
                <Label Grid.Row="0" Grid.Column="0" Content="Cổng COM:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cmbComPort" Margin="5" VerticalAlignment="Center" Height="26" IsEditable="True"
                          ItemsSource="{Binding ComPortList}"
                          SelectedItem="{Binding SelectedComPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="0" Grid.Column="2" Content="Baud Rate:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox Grid.Row="0" Grid.Column="3" x:Name="cmbBaudRate" Margin="5" VerticalAlignment="Center" Height="26"
                          SelectedValuePath="Content"
                          SelectedValue="{Binding SelectedBaudRate, Mode=TwoWay}">
                    <ComboBoxItem Content="9600"/>
                    <ComboBoxItem Content="19200"/>
                    <ComboBoxItem Content="38400"/>
                    <ComboBoxItem Content="57600"/>
                    <ComboBoxItem Content="115200"/>
                </ComboBox>

                <!-- Nút Kết nối / Ngắt kết nối COM -->
                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" Margin="5,0,0,0">
                    <Button x:Name="btnConnectCom" Content="Kết nối COM" Margin="5" Padding="12,5"
                            Command="{Binding ConnectComCommand}"/>
                    <Button x:Name="btnDisconnectCom" Content="Ngắt kết nối" Margin="5" Padding="12,5"
                            Command="{Binding DisconnectComCommand}"/>
                </StackPanel>

                <!-- Gửi dữ liệu COM -->
                <Label Grid.Row="1" Grid.Column="0" Content="Gửi Dữ Liệu:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="txtSendCom" Margin="5" VerticalAlignment="Center" Height="26"
                         Text="{Binding TextToSendCom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Row="1" Grid.Column="4" x:Name="btnSendCom" Content="Gửi Dữ Liệu" Margin="5" Padding="12,5"
                        Command="{Binding SendComDataCommand}"/>
            </Grid>
        </GroupBox>

        <!-- ================= KHU VỰC KẾT NỐI IP CAMERA ================= -->
        <GroupBox Header=" Cấu hình IP Camera " Grid.Row="1" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Địa chỉ IP / RTSP Stream URL -->
                <Label Grid.Row="0" Grid.Column="0" Content="IP / Stream URL:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtCameraIP" Margin="5" VerticalAlignment="Center" Height="26"
                         Text="{Binding CameraIpUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="0" Grid.Column="2" Content="Port:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtCameraPort" Margin="5" VerticalAlignment="Center" Height="26"
                         Text="{Binding CameraPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Nút Kết nối / Ngắt kết nối Camera -->
                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" Margin="5,0,0,0">
                    <Button x:Name="btnStartCamera" Content="Mở Camera" Margin="5" Padding="12,5"
                            Command="{Binding StartCameraCommand}"/>
                    <Button x:Name="btnStopCamera" Content="Tắt Camera" Margin="5" Padding="12,5"
                            Command="{Binding StopCameraCommand}"/>
                </StackPanel>

                <!-- Tài khoản / Mật khẩu Camera -->
                <Label Grid.Row="1" Grid.Column="0" Content="Username:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtCamUser" Margin="5" VerticalAlignment="Center" Height="26"
                         Text="{Binding CameraUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="1" Grid.Column="2" Content="Password:" VerticalAlignment="Center" Margin="5"/>
                <!-- PasswordBox không hỗ trợ DataBinding mặc định vì lý do bảo mật -->
                <PasswordBox Grid.Row="1" Grid.Column="3" x:Name="txtCamPassword" Margin="5" VerticalAlignment="Center" Height="26"/>
            </Grid>
        </GroupBox>

        <!-- ================= KHU VỰC HIỂN THỊ ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Nhận dữ liệu COM -->
            <GroupBox Header=" Dữ liệu COM Nhận Được " Grid.Column="0" Margin="0,0,5,0">
                <TextBox x:Name="txtReceiveCom" Margin="5" 
                         Text="{Binding ReceivedComData, Mode=OneWay}"
                         TextWrapping="Wrap" AcceptsReturn="True" 
                         VerticalScrollBarVisibility="Auto" IsReadOnly="True" 
                         Background="#F9F9F9"/>
            </GroupBox>

            <!-- Khung hiển thị Stream Camera -->
            <GroupBox Header=" Luồng Camera " Grid.Column="1" Margin="5,0,0,0">
                <Grid Background="Black">
                    <Image x:Name="imgCameraStream" Stretch="Uniform"/>
                    <TextBlock Text="Chưa có tín hiệu Video" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Page>