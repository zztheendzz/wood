<Window x:Class="wood.Views.ViewHalcon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:halcon="clr-namespace:HalconDotNet;assembly=halcondotnet"
        xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
        xmlns:local="clr-namespace:wood.Views"
        xmlns:vm="clr-namespace:wood.ViewModels"
        mc:Ignorable="d"
        Title="Halcon Industrial Automation System" Height="740" Width="1280"
        Background="#F1F5F9" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:VM/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Style Button Toolbar chính -->
        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}" x:Name="border">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style TextBox ReadOnly -->
        <Style TargetType="TextBox" x:Key="ReadOnlyTextBoxStyle">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" x:Name="border">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Input Threshold / General Input -->
        <Style TargetType="TextBox" x:Key="InputThresholdTextBoxStyle">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" x:Name="border">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TAB CONTROL CHÍNH -->
        <TabControl Grid.Row="0" Margin="8" Background="Transparent" BorderThickness="0">

            <!-- ================= TAB 1: MAIN INSPECTION ================= -->
            <TabItem Header=" 👁 Main Inspection " FontSize="13" FontWeight="SemiBold">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="450"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="450"/>
                    </Grid.ColumnDefinitions>

                    <!-- CỘT 0: ACTION TOOLBAR DỌC -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Grid.Column="0" Margin="0,0,8,0" Padding="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Color="#000000" Direction="0" Opacity="0.03" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#0284C7" CornerRadius="6" Height="28" Margin="0,0,8,0" Width="28">
                                        <TextBlock FontSize="14" Foreground="White" HorizontalAlignment="Center" Text="👁" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="#0F172A" Text="Vision Pipeline"/>
                                        <TextBlock FontSize="10" Foreground="#64748B" Text="HALCON Engine"/>
                                    </StackPanel>
                                </StackPanel>
                                <Separator Background="#F1F5F9" Margin="0,10,0,0"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
                                <StackPanel>
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" Text="OPERATIONS"/>
                                    <Button Background="#0284C7" Command="{Binding OpenImageCommand}" Content="📂 Chọn Ảnh" Style="{StaticResource ActionButtonStyle}"/>
                                    <Button Background="#10B981" Command="{Binding RunPipelineCommand}" Content="▶ Chạy 1 Lần" Style="{StaticResource ActionButtonStyle}"/>
                                    <Button Background="#64748B" Command="{Binding ClearCommand}" Content="🗑 Xoá Ảnh" Style="{StaticResource ActionButtonStyle}"/>

                                    <Separator Background="#F1F5F9" Margin="0,6,0,8"/>
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" Text="ROI &amp; TRIGGER"/>
                                    <Button Background="#F59E0B" Click="BtnRegion_Click" Content="▣ Chọn Vùng Xử Lý" Style="{StaticResource ActionButtonStyle}"/>
                                    <Button Background="#059669" Click="BtnFinishRegion_Click" Content="✓ Xác Nhận Vùng" Style="{StaticResource ActionButtonStyle}"/>
                                    <Button Background="#0284C7" Click="BtnTrigger_Click" Content="▶ Chụp (Trigger)" Style="{StaticResource ActionButtonStyle}"/>

                                    <Separator Background="#F1F5F9" Margin="0,6,0,8"/>
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" Text="AUTOMATION"/>

                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" Text="⏱ Chu kỳ Auto (s):"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Style="{StaticResource InputThresholdTextBoxStyle}" Margin="0,0,4,0"
                                                         Text="{Binding AutoTimerIntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Column="1" Text="s" VerticalAlignment="Center" FontSize="11" Foreground="#64748B"/>
                                            </Grid>
                                            <Button Command="{Binding ToggleAutoTimerCommand}" Foreground="White" Padding="8,5" FontWeight="SemiBold" BorderThickness="0" HorizontalContentAlignment="Center" >
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                                        <Setter Property="Margin" Value="0"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAutoTimerRunning}" Value="True">
                                                                <Setter Property="Content" Value="⏹ Dừng Auto"/>
                                                                <Setter Property="Background" Value="#EF4444"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsAutoTimerRunning}" Value="False">
                                                                <Setter Property="Content" Value="▶ Bật Auto"/>
                                                                <Setter Property="Background" Value="#0284C7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid Grid.Row="2" Height="0">
                                <nodify:NodifyEditor Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- CỘT 1: HALCON VIEWPORT (CHÍNH) -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" >
                            <Border Background="#0F172A" ClipToBounds="True" CornerRadius="8"  Margin="0,0,8,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" Color="#000000" Direction="0" Opacity="0.06" />
                                </Border.Effect>
                                <Grid>
                                    <halcon:HSmartWindowControlWPF HorizontalAlignment="Stretch" VerticalAlignment="Stretch" x:Name="hWindowControl"/>
                                    <Border Background="#1E293B" CornerRadius="6" HorizontalAlignment="Center" IsHitTestVisible="False" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentImage}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="14" Foreground="#64748B" Margin="0,0,6,0" Text="🖼" VerticalAlignment="Center"/>
                                            <TextBlock FontSize="12" FontWeight="Medium" Foreground="#94A3B8" Text="No Image Loaded" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                </Grid>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1" >

                            <Grid>
                                <halcon:HSmartWindowControlWPF HorizontalAlignment="Stretch" VerticalAlignment="Stretch" x:Name="hWindowControlCrop"/>
                                <Border Background="#1E293B" CornerRadius="6" HorizontalAlignment="Center" IsHitTestVisible="False"  VerticalAlignment="Center"  Padding="14,8,14,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="14" Foreground="#64748B" Margin="0,0,6,0" Text="🖼" VerticalAlignment="Center"/>
                                        <TextBlock FontSize="12" FontWeight="Medium" Foreground="#94A3B8" Text="No Image Loaded" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                            </Grid>


                        </Grid>
                        

                        
                    </Grid>
                    <!-- CỘT 2: CONTROL PANEL & KẾT QUẢ -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Grid.Column="2" Padding="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Color="#000000" Direction="0" Opacity="0.03" />
                        </Border.Effect>
                        <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" Text="Pipeline &amp; Inspection Results"/>

                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2" Text="Image Source Path"/>
                                        <TextBox IsReadOnly="True" Margin="0,0,0,6" Style="{StaticResource ReadOnlyTextBoxStyle}" Text="{Binding ImagePath, Mode=OneWay}" TextWrapping="Wrap"/>
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2" Text="Execution Status"/>
                                        <TextBlock FontSize="11" FontWeight="Medium" Foreground="#0284C7" Text="{Binding StatusMessage}" TextWrapping="Wrap" LineHeight="15"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4" Text="Classification Result"/>
                                <TextBox AcceptsReturn="True" Height="45" IsReadOnly="True" FontSize="22" FontWeight="Bold" 
                                         Foreground="#059669" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" 
                                         Text="{Binding TextureResult.Merterial, Mode=OneWay, FallbackValue='N/A'}" 
                                         TextWrapping="Wrap"/>

                                <Separator Background="#F1F5F9" Margin="0,10,0,10"/>

                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" Text="Metrics Measurement"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,4">
                                        <TextBlock FontSize="11" Foreground="#64748B" Text="Texture Mean"/>
                                        <TextBox IsReadOnly="True" Style="{StaticResource ReadOnlyTextBoxStyle}" Text="{Binding TextureResult.TextureMean, Mode=OneWay, StringFormat={}{0:F2}, FallbackValue='0.00'}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,4">
                                        <TextBlock FontSize="11" Foreground="#64748B" Text="Texture Dev"/>
                                        <TextBox IsReadOnly="True" Style="{StaticResource ReadOnlyTextBoxStyle}" Text="{Binding TextureResult.TextureDeviation, Mode=OneWay, StringFormat={}{0:F2}, FallbackValue='0.00'}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,4">
                                        <TextBlock FontSize="11" Foreground="#64748B" Text="Saturation Mean"/>
                                        <TextBox IsReadOnly="True" Style="{StaticResource ReadOnlyTextBoxStyle}" Text="{Binding TextureResult.SaturationMean, Mode=OneWay, StringFormat={}{0:F2}, FallbackValue='0.00'}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,4">
                                        <TextBlock FontSize="11" Foreground="#64748B" Text="Saturation Dev"/>
                                        <TextBox IsReadOnly="True" Style="{StaticResource ReadOnlyTextBoxStyle}" Text="{Binding TextureResult.SaturationDeviation, Mode=OneWay, StringFormat={}{0:F2}, FallbackValue='0.00'}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock FontSize="11" Foreground="#64748B" Text="Gray Mean"/>
                                        <TextBox IsReadOnly="True" Style="{StaticResource ReadOnlyTextBoxStyle}" Text="{Binding TextureResult.GrayMean, Mode=OneWay, StringFormat={}{0:F2}, FallbackValue='0.00'}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock FontSize="11" Foreground="#64748B" Text="Gray Dev"/>
                                        <TextBox IsReadOnly="True" Style="{StaticResource ReadOnlyTextBoxStyle}" Text="{Binding TextureResult.GrayDeviation, Mode=OneWay, StringFormat={}{0:F2}, FallbackValue='0.00'}"/>
                                    </StackPanel>
                                </Grid>

                                <Separator Background="#F1F5F9" Margin="0,0,0,10"/>

                                <UniformGrid Columns="2">
                                    <Button Content="💾 Lưu Cấu Hình" Command="{Binding SaveConfigCommand}" Margin="0,0,3,0" Padding="8,6" Background="#0284C7" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
                                    <Button Content="📂 Tải Cấu Hình" Command="{Binding LoadConfigCommand}" Margin="3,0,0,0" Padding="8,6" Background="#64748B" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= TAB 2: HARDWARE, COM, PLC, ROBOT & CAMERA ================= -->
            <TabItem Header=" 🔌 HW, COM, PLC &amp; Robot " FontSize="13" FontWeight="SemiBold">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <!-- Cột trái: Cấu hình phần cứng, COM, Mã tín hiệu, Log nhận, PLC, Robot -->
                        <ColumnDefinition Width="*"/>
                        <!-- Cột phải: Khung Live Stream camera thu gọn + Thanh trượt thông số -->
                        <ColumnDefinition Width="580"/>
                    </Grid.ColumnDefinitions>

                    <!-- CỘT 0: CÁC KHUNG CẤU HÌNH PHẦN CỨNG & TÍN HIỆU COM -->
                    <ScrollViewer Grid.Column="0" Margin="0,0,8,0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <StackPanel>
                            <!-- 1. Thư mục lưu ảnh -->
                            <GroupBox Header=" 📁 Thư Mục Lưu Ảnh " Margin="0,0,0,8" Padding="8" Foreground="#0F172A" FontWeight="Bold">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="95"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" IsReadOnly="True" Style="{StaticResource ReadOnlyTextBoxStyle}" 
                                             Text="{Binding SaveFolderPath, Mode=OneWay, FallbackValue='D:\Images\Processed'}" 
                                             VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Content="📁 Chọn Thư Mục" Command="{Binding SelectFolderCommand}" 
                                            Background="#0284C7" Foreground="White" Padding="6,5" FontWeight="SemiBold" BorderThickness="0"/>
                                </Grid>
                            </GroupBox>

                            <!-- 2. Cổng COM & Cấu hình Mã Tín Hiệu Gửi/Nhận + Log Dữ Liệu -->
                            <GroupBox Header=" 🔌 Cổng COM &amp; Cấu Hình Tín Hiệu (Serial) " Margin="0,0,0,8" Padding="8" Foreground="#0F172A" FontWeight="Bold">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Cổng COM:" VerticalAlignment="Center" Foreground="#475569" FontWeight="Normal"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding ComPortList}" SelectedItem="{Binding SelectedComPort}" Margin="4,0" Height="26" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="2" Content="🔄 Scan" Command="{Binding RefreshComPortsCommand}" Background="#F59E0B" Foreground="White" Padding="8,4" FontWeight="SemiBold" BorderThickness="0"/>
                                    </Grid>

                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <Button Content="▶ Kết Nối COM" Command="{Binding ConnectComCommand}" Background="#10B981" Foreground="White" Padding="6,5" Margin="0,0,3,0" FontWeight="SemiBold" BorderThickness="0"/>
                                        <Button Content="⏹ Ngắt COM" Command="{Binding DisconnectComCommand}" Background="#EF4444" Foreground="White" Padding="6,5" Margin="3,0,0,0" FontWeight="SemiBold" BorderThickness="0"/>
                                    </UniformGrid>

                                    <Separator Background="#E2E8F0" Margin="0,2,0,8"/>
                                    <TextBlock Text="⚙ Cấu Hình Mã Tín Hiệu (Gửi / Nhận):" VerticalAlignment="Center" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Mã Nhận (Trigger) -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nhận (Trigger):" VerticalAlignment="Center" Foreground="#475569" FontSize="11"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource InputThresholdTextBoxStyle}" Margin="0,2" Text="{Binding ComTriggerSignal, Mode=TwoWay}"/>

                                        <!-- Mã Gửi (Gỗ) -->
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Gửi (Gỗ):" VerticalAlignment="Center" Foreground="#475569" FontSize="11"/>
                                        <TextBox Grid.Row="0" Grid.Column="4" Style="{StaticResource InputThresholdTextBoxStyle}" Margin="0,2" Text="{Binding ComResponseGo, Mode=TwoWay}"/>

                                        <!-- Mã Gửi (Xốp) -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Gửi (Xốp):" VerticalAlignment="Center" Foreground="#475569" FontSize="11"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InputThresholdTextBoxStyle}" Margin="0,2" Text="{Binding ComResponseXop, Mode=TwoWay}"/>

                                        <!-- Mã Gửi (Lỗi) -->
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Gửi (Lỗi):" VerticalAlignment="Center" Foreground="#475569" FontSize="11"/>
                                        <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource InputThresholdTextBoxStyle}" Margin="0,2" Text="{Binding ComResponseError, Mode=TwoWay}"/>

                                        <!-- End Char Nhận -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                                            <CheckBox Content="End (Rx):" IsChecked="{Binding UseReceiveEndChar}" VerticalAlignment="Center" Foreground="#475569" FontSize="11" Margin="0,0,4,0"/>
                                            <ComboBox IsEnabled="{Binding UseReceiveEndChar}" SelectedValue="{Binding ReceiveEndChar, Mode=TwoWay}" SelectedValuePath="Content" FontSize="11" Width="55" Height="24" VerticalContentAlignment="Center" IsEditable="True">
                                                <ComboBoxItem Content="\r\n"/>
                                                <ComboBoxItem Content="\r"/>
                                                <ComboBoxItem Content="\n"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- End Char Gửi -->
                                        <StackPanel Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                                            <CheckBox Content="End (Tx):" IsChecked="{Binding UseLineEnding}" VerticalAlignment="Center" Foreground="#475569" FontSize="11" Margin="0,0,4,0"/>
                                            <ComboBox IsEnabled="{Binding UseLineEnding}" SelectedValue="{Binding ComLineEnding, Mode=TwoWay}" SelectedValuePath="Content" FontSize="11" Width="55" Height="24" VerticalContentAlignment="Center" IsEditable="True">
                                                <ComboBoxItem Content="\r\n"/>
                                                <ComboBoxItem Content="\r"/>
                                                <ComboBoxItem Content="\n"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Khung Log Dữ Liệu Nhận -->
                                    <Separator Background="#E2E8F0" Margin="0,2,0,6"/>
                                    <TextBlock Text="📡 Log Dữ Liệu Nhận:" VerticalAlignment="Center" Foreground="#475569" FontWeight="Normal" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtReceiveCom" Height="85" Margin="0" 
                                             Text="{Binding ReceivedComDataAll, Mode=OneWay}"
                                             TextWrapping="Wrap" AcceptsReturn="True" 
                                             VerticalScrollBarVisibility="Auto" IsReadOnly="True" 
                                             Background="#1E293B" Foreground="#38BDF8"
                                             FontFamily="Consolas" FontSize="11" Padding="6"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- 3. Kết nối PLC -->
                            <GroupBox Header=" ⚡ Kết Nối PLC (Mitsubishi / Modbus TCP) " Margin="0,0,0,8" Padding="8" Foreground="#0F172A" FontWeight="Bold">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="PLC IP:" VerticalAlignment="Center" Foreground="#475569" FontWeight="Normal"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource InputThresholdTextBoxStyle}" Margin="4,0" Text="{Binding PlcIpAddress, Mode=TwoWay}" TextAlignment="Left"/>
                                        <TextBox Grid.Column="2" Style="{StaticResource InputThresholdTextBoxStyle}" Text="{Binding PlcPort, Mode=TwoWay}"/>
                                    </Grid>
                                    <UniformGrid Columns="2" Margin="0,2,0,0">
                                        <Button Content="▶ Kết Nối PLC" Command="{Binding ConnectPlcCommand}" Background="#10B981" Foreground="White" Padding="6,5" Margin="0,0,3,0" FontWeight="SemiBold" BorderThickness="0"/>
                                        <Button Content="⏹ Ngắt PLC" Command="{Binding DisconnectPlcCommand}" Background="#EF4444" Foreground="White" Padding="6,5" Margin="3,0,0,0" FontWeight="SemiBold" BorderThickness="0"/>
                                    </UniformGrid>
                                </StackPanel>
                            </GroupBox>

                            <!-- 4. Kết nối Robot -->
                            <GroupBox Header=" 🤖 Kết Nối Robot (Epson / TCP Socket) " Margin="0" Padding="8" Foreground="#0F172A" FontWeight="Bold">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Robot IP:" VerticalAlignment="Center" Foreground="#475569" FontWeight="Normal"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource InputThresholdTextBoxStyle}" Margin="4,0" Text="{Binding RobotIpAddress, Mode=TwoWay}" TextAlignment="Left"/>
                                        <TextBox Grid.Column="2" Style="{StaticResource InputThresholdTextBoxStyle}" Text="{Binding RobotPort, Mode=TwoWay}"/>
                                    </Grid>
                                    <UniformGrid Columns="2" Margin="0,2,0,0">
                                        <Button Content="▶ Kết Nối Robot" Command="{Binding ConnectRobotCommand}" Background="#10B981" Foreground="White" Padding="6,5" Margin="0,0,3,0" FontWeight="SemiBold" BorderThickness="0"/>
                                        <Button Content="⏹ Ngắt Robot" Command="{Binding DisconnectRobotCommand}" Background="#EF4444" Foreground="White" Padding="6,5" Margin="3,0,0,0" FontWeight="SemiBold" BorderThickness="0"/>
                                    </UniformGrid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- CỘT 1: LIVE STREAM CAMERA (THU GỌN) & CÁC SLIDER THÔNG SỐ -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="500"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Live Stream thu gọn -->
                        <GroupBox Header=" 🎥 Live Stream Camera " Grid.Row="0" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,0,8">
                            <Border Background="Black" ClipToBounds="True" CornerRadius="6">
                                <halcon:HSmartWindowControlWPF x:Name="hWindowControlLive" 
                                                           HorizontalAlignment="Stretch" 
                                                           VerticalAlignment="Stretch"/>
                            </Border>
                        </GroupBox>

                        <!-- Sliders Thông số Camera đầy đủ -->
                        <GroupBox Header=" 🎛 Điều Chỉnh Thông Số Camera " Grid.Row="1" Padding="8" Foreground="#0F172A" FontWeight="Bold">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Camera:" VerticalAlignment="Center" Foreground="#475569" FontWeight="Normal"/>
                                        <ComboBox Grid.Column="1" Margin="4,0" Height="26" VerticalContentAlignment="Center" IsEditable="True"
                                                  ItemsSource="{Binding CameraList}" SelectedItem="{Binding SelectedCameraDevice, Mode=TwoWay}"/>
                                        <Button Grid.Column="2" Content="🔍 Quét" Padding="8,4" Command="{Binding ScanGigECamerasCommand}" Background="#0284C7" Foreground="White" BorderThickness="0"/>
                                    </Grid>
                                    <UniformGrid Columns="2" Margin="0,2,0,8">
                                        <Button Content="▶ Mở Camera" Command="{Binding StartCameraCommand}" Background="#10B981" Foreground="White" Padding="6,5" Margin="0,0,3,0" FontWeight="SemiBold" BorderThickness="0"/>
                                        <Button Content="⏹ Tắt Camera" Command="{Binding StopCameraCommand}" Background="#EF4444" Foreground="White" Padding="6,5" Margin="3,0,0,0" FontWeight="SemiBold" BorderThickness="0"/>
                                    </UniformGrid>

                                    <!-- Sliders -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Exposure Time -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Exposure:" VerticalAlignment="Center" FontSize="11" Foreground="#475569" FontWeight="Normal"/>
                                        <Slider Grid.Row="0" Grid.Column="1" Margin="6,0" VerticalAlignment="Center" 
                                                Minimum="20" Maximum="300000" Value="{Binding CamExposure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Center" Height="24" FontSize="11"
                                                 Text="{Binding CamExposure, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                                        <!-- Gain -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Gain:" VerticalAlignment="Center" FontSize="11" Foreground="#475569" FontWeight="Normal" Margin="0,6,0,0"/>
                                        <Slider Grid.Row="1" Grid.Column="1" Margin="6,6,6,0" VerticalAlignment="Center" 
                                                Minimum="1.0" Maximum="8.0" TickFrequency="0.1" Value="{Binding CamGain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Center" Height="24" FontSize="11" Margin="0,6,0,0"
                                                 Text="{Binding CamGain, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F1}}"/>

                                        <!-- Frame Rate -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Frame Rate:" VerticalAlignment="Center" FontSize="11" Foreground="#475569" FontWeight="Normal" Margin="0,6,0,0"/>
                                        <Slider Grid.Row="2" Grid.Column="1" Margin="6,6,6,0" VerticalAlignment="Center" 
                                                Minimum="1" Maximum="120" Value="{Binding CamFrameRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Center" Height="24" FontSize="11" Margin="0,6,0,0"
                                                 Text="{Binding CamFrameRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                                        <!-- Contrast -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Contrast:" VerticalAlignment="Center" FontSize="11" Foreground="#475569" FontWeight="Normal" Margin="0,6,0,0"/>
                                        <Slider Grid.Row="3" Grid.Column="1" Margin="6,6,6,0" VerticalAlignment="Center" 
                                                Minimum="0" Maximum="200" Value="{Binding CamContrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Center" Height="24" FontSize="11" Margin="0,6,0,0"
                                                 Text="{Binding CamContrast, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                                        <!-- Gamma -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Gamma:" VerticalAlignment="Center" FontSize="11" Foreground="#475569" FontWeight="Normal" Margin="0,6,0,0"/>
                                        <Slider Grid.Row="4" Grid.Column="1" Margin="6,6,6,0" VerticalAlignment="Center" 
                                                Minimum="0" Maximum="255" Value="{Binding CamGamma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Center" Height="24" FontSize="11" Margin="0,6,0,0"
                                                 Text="{Binding CamGamma, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- STATUS BAR -->
        <StatusBar Background="#1E293B" Foreground="#94A3B8" Grid.Row="1" Padding="10,4">
            <StatusBarItem HorizontalAlignment="Stretch">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock FontSize="11" Foreground="#64748B" Text="Status: "/>
                        <TextBlock FontSize="11" Foreground="#E2E8F0" Text="{Binding StatusMessage}"/>
                    </StackPanel>
                </Grid>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>