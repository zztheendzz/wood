<Window x:Class="wood.Views.testTool"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wood.Views"
        xmlns:halcon="clr-namespace:HalconDotNet;assembly=halcondotnet"
        xmlns:vm="clr-namespace:wood.ViewModels"
        xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
        mc:Ignorable="d"
        Title="testTool" Height="450" Width="800">
    <Window.DataContext>
        <vm:VM/>
    </Window.DataContext>

    <Grid Background="#F5F5F5">
        
        <Grid.RowDefinitions>
            <!-- Khu vực Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Khu vực Main Workspace -->
            <RowDefinition Height="*"/>
            <!-- Khu vực Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. TOOLBAR / MENU TRÊN CÙNG -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,8">
            
            <StackPanel Orientation="Horizontal">
                <Button Content="📂 Open Image" 
                        Command="{Binding OpenImageCommand}" 
                        Padding="12,6" Margin="0,0,8,0"
                        Background="#007ACC" Foreground="White" FontWeight="SemiBold"
                        BorderThickness="0"/>

                <Button Content="▶ Run Pipeline" 
                        Command="{Binding RunPipelineCommand}" 
                        Padding="12,6" Margin="0,0,8,0"
                        Background="#28A745" Foreground="White" FontWeight="SemiBold"
                        BorderThickness="0"/>

                <Button Content="🗑 Clear" 
                        Command="{Binding ClearCommand}" 
                        Padding="12,6"
                        Background="#6C757D" Foreground="White" FontWeight="SemiBold"
                        BorderThickness="0"/>
                <Grid>
                    <nodify:NodifyEditor />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 2. MAIN CONTENT AREA -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <!-- Cột trái: Hiển thị hình ảnh -->
                <ColumnDefinition Width="*"/>
                <!-- Cột phải: Control Panel / Kết quả -->
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- KHU VỰC HIỂN THỊ ẢNH HALCON -->
            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="4" Margin="0,0,10,0" ClipToBounds="True">
                
                <Grid>
                    <halcon:HSmartWindowControlWPF x:Name="hWindowControl" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <!-- HALCON CONTROL: Tự động zoom, pan ảnh -->
                    <!-- Lưu ý: Nếu muốn bind CurrentImage vào HSmartWindowControlWPF, bạn cần xử lý qua Dependency Properties hoặc Event/Behavior trong Code-Behind -->


                    <!-- Lớp hiển thị đường dẫn ảnh làm watermark khi chưa load -->
                    <TextBlock Text="No Image Loaded" 
                               Foreground="#666666" FontSize="18" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- KHU VỰC THÔNG TIN & THIẾT LẬP (RIGHT PANEL) -->
            <Border Grid.Column="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Pipeline Information" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333333"/>

                        <!-- Thông tin File Ảnh -->
                        <TextBlock Text="Image Path:" FontWeight="SemiBold" Foreground="#666666"/>
                        <TextBox Text="{Binding ImagePath, Mode=OneWay}" 
                                 IsReadOnly="True" 
                                 TextWrapping="Wrap" 
                                 Margin="0,5,0,15" 
                                 Padding="5" Background="#F8F9FA"/>

                        <Separator Margin="0,5,15,15"/>

                        <!-- Trạng thái kết quả thành công / thất bại -->
                        <TextBlock Text="Execution Result:" FontWeight="SemiBold" Foreground="#666666"/>
                        <Border Margin="0,8,0,15" Padding="10" CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#E9ECEF"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentResult.Success}" Value="True">
                                            <Setter Property="Background" Value="#D4EDDA"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentResult.Success}" Value="False">
                                            <Setter Property="Background" Value="#F8D7DA"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CurrentResult.Message, FallbackValue='No pipeline run yet'}" 
                                       TextWrapping="Wrap" FontWeight="Medium">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#495057"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentResult.Success}" Value="True">
                                                <Setter Property="Foreground" Value="#155724"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentResult.Success}" Value="False">
                                                <Setter Property="Foreground" Value="#721C24"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 3. STATUS BAR DƯỚI CÙNG -->
        <StatusBar Grid.Row="2" Background="#007ACC" Foreground="White" Padding="5,3">
            <StatusBarItem HorizontalAlignment="Stretch">
                <Grid HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"/>
                </Grid>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
